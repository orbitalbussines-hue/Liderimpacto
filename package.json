{
  "name": "lider-impacto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3011",
    "build": "next build",
    "start": "next start -p 3011",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config config/vitest.config.mts",
    "test:compliance": "node tests/check-compliance.test.mjs",
    "compliance": "node scripts/check-compliance.mjs",
    "map": "node scripts/project-map.mjs --out docs/PROJECT_MAP.md",
    "docs:check": "node scripts/docs-check.mjs",
    "ai-marks": "node scripts/remove-ai-marks.mjs --check --dir docs",
    "lixo": "node scripts/limpar-lixo-raiz.mjs",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "verificar": "npm run lint && npm run typecheck && npm run compliance && npm run test:compliance && npm test && npm run docs:check",
    "prepare": "node scripts/ativar-hooks.mjs",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "seed:demo:legendas": "tsx --conditions=react-server scripts/seed-demo-legendas.ts",
    "sessao:demo": "tsx --conditions=react-server scripts/sessao-demo.ts",
    "armazenamento:preparar": "tsx --conditions=react-server scripts/armazenamento-preparar.ts",
    "worker:video": "tsx --conditions=react-server scripts/worker-video.ts",
    "video:reconferir": "tsx --conditions=react-server scripts/video-reconferir.ts",
    "worker:certificados": "tsx --conditions=react-server scripts/worker-certificados.ts",
    "gamificacao:recalcular": "tsx --conditions=react-server scripts/gamificacao-recalcular.ts",
    "conhecimento:reindexar": "tsx --conditions=react-server scripts/conhecimento-reindexar.ts",
    "seed:demo:assistente": "tsx --conditions=react-server scripts/seed-demo-assistente.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/utils": "0.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "better-auth": "1.7.7",
    "bullmq": "6.3.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "hls.js": "1.7.3",
    "ioredis": "6.0.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "nodemailer": "10.1.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "stripe": "23.0.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
