# Variáveis da HML no EASYPANEL (ADR-0016) — MODELO, sem nenhum valor real. Cada bloco [nome] vai na
# aba Environment do serviço de mesmo nome (formato .env: NOME=valor, sem aspas, sem espaços).
# Os valores reais ficam SÓ no Easypanel e no gerenciador de senhas do Paulo — nunca no git nem no chat.
#
# COMO GERAR (Git Bash no Windows; o openssl vem com o Git). Gere UMA vez e reuse o mesmo valor onde
# o mesmo nome aparece em mais de um bloco:
#   openssl rand -hex 32        -> DB_MIGRACAO_SENHA, DB_APP_SENHA, REDIS_SENHA, S3_SEGREDO
#   openssl rand -hex 16        -> S3_CHAVE
#   openssl rand -base64 48     -> BETTER_AUTH_SECRET
#   openssl rand -base64 32     -> VIDEO_CHAVE_MESTRA, VIDEO_SEGREDO_TOKEN
# Senhas que entram em URL (banco, Redis) são HEX: só 0-9a-f, nada para escapar.
# Hosts internos = <projeto>_<serviço> (confira na aba Credentials do Postgres).

# ============================================================================================
# [traefik]  Settings > Traefik > Environment (do SERVIDOR, não do projeto). Depois: Restart.
# ============================================================================================
# O e-mail TEM que ser o mesmo dos outros resolvers que já existirem (a doc do Easypanel exige).
TRAEFIK_CERTIFICATESRESOLVERS_CLOUDFLARE_ACME_EMAIL=email-ja-usado-no-letsencrypt@exemplo.com
TRAEFIK_CERTIFICATESRESOLVERS_CLOUDFLARE_ACME_STORAGE="/data/acme.json"
TRAEFIK_CERTIFICATESRESOLVERS_CLOUDFLARE_ACME_DNSCHALLENGE_PROVIDER=cloudflare
TRAEFIK_CERTIFICATESRESOLVERS_CLOUDFLARE_ACME_DNSCHALLENGE_RESOLVERS=1.1.1.1,8.8.8.8
# Token da Cloudflare (Zone:Zone:Read + Zone:DNS:Edit, SÓ a zona liderdeimpacto.com.br). Nome do lego.
CF_DNS_API_TOKEN=cole-o-token-da-cloudflare

# ============================================================================================
# [db]  Postgres do Easypanel: na criação, Image = postgres:16.15, Database = lider_impacto_hml.
# A senha do `postgres` o Easypanel gera. As dos papéis abaixo entram pelo banco-bootstrap.sql.
# ============================================================================================

# ============================================================================================
# [redis]
# ============================================================================================
REDIS_SENHA=gere-com-openssl-rand-hex-32

# ============================================================================================
# [storage]
# ============================================================================================
S3_CHAVE=gere-com-openssl-rand-hex-16
S3_SEGREDO=gere-com-openssl-rand-hex-32

# ============================================================================================
# [ferramentas]  migração (DONO do banco) + buckets/CORS + seed manual. Única com a senha do dono.
# ============================================================================================
DATABASE_URL=postgres://lider_migracao:DB_MIGRACAO_SENHA@lider-impacto_db:5432/lider_impacto_hml
DB_APP_USUARIO=lider_app
SAUDE_ARQUIVO=/tmp/migracoes-em-dia
# Para o seed (rodado À MÃO como lider_app: DATABASE_URL="$DATABASE_URL_APP" npm run -s db:seed):
DATABASE_URL_APP=postgres://lider_app:DB_APP_SENHA@lider-impacto_db:5432/lider_impacto_hml
BETTER_AUTH_SECRET=gere-com-openssl-rand-base64-48
BETTER_AUTH_URL=https://hml.liderdeimpacto.com.br
PLATAFORMA_DOMINIO=hml.liderdeimpacto.com.br
S3_ENDPOINT=https://s3.hml.liderdeimpacto.com.br
S3_REGIAO=us-east-1
S3_CHAVE=a-mesma-do-storage
S3_SEGREDO=o-mesmo-do-storage
S3_FORCAR_CAMINHO=true
S3_BUCKET_ARQUIVOS=lider-arquivos
S3_BUCKET_VIDEOS_ORIGINAIS=lider-videos-originais
S3_BUCKET_HLS=lider-hls

# ============================================================================================
# [app]
# ============================================================================================
DATABASE_URL=postgres://lider_app:DB_APP_SENHA@lider-impacto_db:5432/lider_impacto_hml
REDIS_URL=redis://:REDIS_SENHA@lider-impacto_redis:6379
VIDEO_FILA_PREFIXO=li
PLATAFORMA_DOMINIO=hml.liderdeimpacto.com.br
# HTTPS obrigatório: o app RECUSA subir com http:// em produção.
BETTER_AUTH_URL=https://hml.liderdeimpacto.com.br
BETTER_AUTH_SECRET=o-mesmo-das-ferramentas
# Cifra a chave AES de cada vídeo. NUNCA trocar sem rotação (docs/back.md). Guarde no cofre.
VIDEO_CHAVE_MESTRA=gere-com-openssl-rand-base64-32
VIDEO_SEGREDO_TOKEN=gere-com-openssl-rand-base64-32
VIDEO_LIMITE_SESSOES=2
# Endpoint PÚBLICO: o navegador sobe arquivo direto nele (URL pré-assinada); app e worker usam o mesmo.
S3_ENDPOINT=https://s3.hml.liderdeimpacto.com.br
S3_REGIAO=us-east-1
S3_CHAVE=a-mesma-do-storage
S3_SEGREDO=o-mesmo-do-storage
S3_FORCAR_CAMINHO=true
S3_BUCKET_ARQUIVOS=lider-arquivos
S3_BUCKET_VIDEOS_ORIGINAIS=lider-videos-originais
S3_BUCKET_HLS=lider-hls
# Assistente (Claude), opcional: vazio = "IA não configurada". Chave de um workspace só da HML.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODELO=
ASSISTENTE_TETO_DIARIO_CRIADOR=500
# E-mail (SMTP Hostinger), AINDA NÃO: vazio = links aparecem na tela.
SMTP_HOST=
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=

# ============================================================================================
# [worker-certificados]
# ============================================================================================
DATABASE_URL=postgres://lider_app:DB_APP_SENHA@lider-impacto_db:5432/lider_impacto_hml
REDIS_URL=redis://:REDIS_SENHA@lider-impacto_redis:6379
VIDEO_FILA_PREFIXO=li
PLATAFORMA_DOMINIO=hml.liderdeimpacto.com.br
BETTER_AUTH_URL=https://hml.liderdeimpacto.com.br
S3_ENDPOINT=https://s3.hml.liderdeimpacto.com.br
S3_REGIAO=us-east-1
S3_CHAVE=a-mesma-do-storage
S3_SEGREDO=o-mesmo-do-storage
S3_FORCAR_CAMINHO=true
S3_BUCKET_ARQUIVOS=lider-arquivos
S3_BUCKET_VIDEOS_ORIGINAIS=lider-videos-originais
S3_BUCKET_HLS=lider-hls

# ============================================================================================
# [worker-video]
# ============================================================================================
DATABASE_URL=postgres://lider_app:DB_APP_SENHA@lider-impacto_db:5432/lider_impacto_hml
REDIS_URL=redis://:REDIS_SENHA@lider-impacto_redis:6379
VIDEO_FILA_PREFIXO=li
VIDEO_CHAVE_MESTRA=a-mesma-do-app
S3_ENDPOINT=https://s3.hml.liderdeimpacto.com.br
S3_REGIAO=us-east-1
S3_CHAVE=a-mesma-do-storage
S3_SEGREDO=o-mesmo-do-storage
S3_FORCAR_CAMINHO=true
S3_BUCKET_ARQUIVOS=lider-arquivos
S3_BUCKET_VIDEOS_ORIGINAIS=lider-videos-originais
S3_BUCKET_HLS=lider-hls

# ============================================================================================
# [backup]  arquivos -> R2 todo dia; banco só se BACKUP_BANCO=1 (plano B, ver runbook).
# ============================================================================================
# R2 > Overview > Account ID:  https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=li-backups-hml
# Token R2 "Object Read & Write" restrito a ESSE bucket (o mesmo do Storage Provider do Easypanel).
R2_BACKUP_ACCESS_KEY_ID=cole-o-access-key-id
R2_BACKUP_SECRET_ACCESS_KEY=cole-o-secret-access-key
# SeaweedFS pela rede interna do projeto (origem da cópia dos arquivos).
S3_INTERNO=http://lider-impacto_storage:8333
S3_CHAVE=a-mesma-do-storage
S3_SEGREDO=o-mesmo-do-storage
# Dono do banco: pg_dump do plano B e a contagem do `backup restaurar-teste`.
DATABASE_URL=postgres://lider_migracao:DB_MIGRACAO_SENHA@lider-impacto_db:5432/lider_impacto_hml
# 06:30 UTC = 03:30 de Brasília (fora do pico da página de vendas).
BACKUP_HORA_UTC=06:30
BACKUP_BANCO=0
