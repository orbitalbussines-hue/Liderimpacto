# /opt/lider-impacto/.env da VPS de HML — MODELO. O arquivo real é criado pelo Paulo NO SERVIDOR
# (docs/deploy-hml.md, passo 7), com `chmod 600`, e NUNCA entra no git nem no chat.
# Formato: NOME=valor, sem aspas e sem espaços. Senhas que entram em URL (banco, Redis) são HEX
# (`openssl rand -hex 32`): só 0-9a-f, nada para escapar.
# O compose repassa a cada serviço SÓ o que ele usa (deploy/hml/docker-compose.yml).

# --- Domínio e borda -------------------------------------------------------------------------
# Apex da HML = plataforma (SUPER_ADMIN); <slug>.apex = área de cada criador.
PLATAFORMA_DOMINIO=hml.lideresdeimpacto.com.br
# URL pública da plataforma. HTTPS obrigatório: o app RECUSA subir com http:// em produção.
BETTER_AUTH_URL=https://hml.lideresdeimpacto.com.br
# E-mail que recebe avisos da Let's Encrypt (certificado expirando etc.).
ACME_EMAIL=voce@exemplo.com
# Token da Cloudflare SÓ para o Caddy (desafio DNS-01 do certificado *.hml). Permissão única:
# Zone > DNS > Edit, restrita à zona lideresdeimpacto.com.br (passo 4 do runbook).
CLOUDFLARE_API_TOKEN=cole-o-token-da-cloudflare

# --- Banco (PostgreSQL 16, só na rede interna) -----------------------------------------------
DB_NOME=lider_impacto_hml
# Superusuário `postgres` (manutenção/pg_dump; a app nunca usa):   openssl rand -hex 32
DB_SUPERUSUARIO_SENHA=gere-com-openssl-rand-hex-32
# Papel dono do banco, usado SÓ pelas migrações:                   openssl rand -hex 32
DB_MIGRACAO_SENHA=gere-com-openssl-rand-hex-32
# Papel da aplicação e dos workers (sem DDL):                       openssl rand -hex 32
DB_APP_SENHA=gere-com-openssl-rand-hex-32
# ATENÇÃO: as 3 senhas acima só valem na PRIMEIRA subida do banco (volume vazio). Trocar depois =
# ALTER ROLE no banco (docs/deploy-hml.md, "Trocar uma senha").

# --- Fila (Redis, só na rede interna) --------------------------------------------------------
REDIS_SENHA=gere-com-openssl-rand-hex-32

# --- Storage S3 (SeaweedFS na VPS) -----------------------------------------------------------
# Endpoint PÚBLICO: o navegador sobe arquivo direto nele (URL pré-assinada) e app/worker usam o mesmo.
S3_ENDPOINT=https://s3.hml.lideresdeimpacto.com.br
# Credencial que o SeaweedFS aceita e o app usa:    openssl rand -hex 16   /   openssl rand -hex 32
S3_CHAVE=gere-com-openssl-rand-hex-16
S3_SEGREDO=gere-com-openssl-rand-hex-32

# --- Segredos do app -------------------------------------------------------------------------
# Assina cookie, desafio do 2FA e cifra a semente do TOTP (>= 32 caracteres):   openssl rand -base64 48
BETTER_AUTH_SECRET=gere-com-openssl-rand-base64-48
# Cifra a chave AES de cada vídeo (32 bytes em base64). NUNCA trocar sem rotação (docs/back.md):
#   openssl rand -base64 32
VIDEO_CHAVE_MESTRA=gere-com-openssl-rand-base64-32
# Assina o token de reprodução (>= 32 caracteres):   openssl rand -base64 32
VIDEO_SEGREDO_TOKEN=gere-com-openssl-rand-base64-32
# Telas simultâneas por pessoa (1 a 10).
VIDEO_LIMITE_SESSOES=2

# --- Assistente do professor (Claude) — opcional: vazio = "IA não configurada" ---------------
# Chave do console da Anthropic (Settings > API keys), de um workspace só da HML, com limite de gasto.
ANTHROPIC_API_KEY=
# Só para chave de ORGANIZAÇÃO (não ligada a workspace): o id wrkspc_... do workspace.
ANTHROPIC_WORKSPACE_ID=
# Vazio = padrão do código (claude-sonnet-5-5).
ANTHROPIC_MODELO=
# Teto de perguntas por criador por dia (protege a conta).
ASSISTENTE_TETO_DIARIO_CRIADOR=500

# --- Pagamentos (Stripe Connect, ADR-0019) — opcional: vazio = "Pagamentos não configurados" -----
# Chave secreta de TESTE (sk_test_…) da conta da plataforma e o whsec_… do endpoint Connect da HML.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- E-mail (SMTP Hostinger) — AINDA NÃO: vazio = links aparecem na tela ---------------------
SMTP_HOST=
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=

# --- Backup -> Cloudflare R2 (só o backup.sh e o restaurar-teste.sh leem) ---------------------
# Endpoint S3 da conta: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (R2 > Overview > Account ID).
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# Bucket PRIVADO dedicado ao backup da HML.
R2_BACKUP_BUCKET=li-backups-hml
# Token R2 "Object Read & Write" restrito a ESSE bucket (passo 12 do runbook).
R2_BACKUP_ACCESS_KEY_ID=cole-o-access-key-id
R2_BACKUP_SECRET_ACCESS_KEY=cole-o-secret-access-key
