# Copie para .env e ajuste. O .env NUNCA vai para o git.
# Valores abaixo sao SO de desenvolvimento local (Docker). Nada aqui e credencial real.

# --- Banco (PostgreSQL 16 via Docker; nunca SQLite) ---
DB_NAME=lider_impacto_dev
DB_USER=dev
DB_PASSWORD=dev
DB_PORT=5442
DATABASE_URL=postgres://dev:dev@localhost:5442/lider_impacto_dev
# Banco dos testes de integracao (npm test). Precisa terminar em _teste; o teste recusa o de dev.
# Crie uma vez: docker compose exec db createdb -U dev lider_impacto_teste
# e aplique as migracoes nele: DATABASE_URL=<esta url> npm run db:migrate
DATABASE_URL_TESTE=postgres://dev:dev@localhost:5442/lider_impacto_teste

# --- Plataforma e areas dos criadores (ADR-0002/0003) ---
# Dominio da plataforma: apex = area da plataforma; <slug>.<dominio> = area do criador.
# Producao: liderdeimpacto.com.br. Dev: localhost (o Chrome resolve *.localhost sozinho:
# http://lider-de-impacto.localhost:3011).
PLATAFORMA_DOMINIO=localhost

# --- Autenticacao (Better Auth) ---
# URL PUBLICA do apex. Producao: https://liderdeimpacto.com.br (https obrigatorio; o boot
# recusa outra coisa). Os links de senha dos criadores saem daqui: <protocolo>//<slug>.<host>.
BETTER_AUTH_URL=http://localhost:3011
# Segredo que assina cookies e cifra a semente do TOTP e os codigos de recuperacao.
# >= 32 caracteres; gere com: openssl rand -base64 32. Cada ambiente tem o seu.
BETTER_AUTH_SECRET=636cabf0e531d0c411f6045469db0d2e

# --- E-mail (SMTP da Hostinger) ---
# Sem SMTP_HOST/SMTP_USUARIO/SMTP_SENHA/EMAIL_REMETENTE completos, NENHUM e-mail sai e o
# "esqueci a senha" orienta a pedir o link a equipe (link na tela, ADR-0003).
SMTP_HOST=
# 465 = TLS direto (padrao da Hostinger); 587 = STARTTLS.
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
# Ex.: "Líder de Impacto <nao-responda@exemplo.com>"
EMAIL_REMETENTE=

# --- Seed (npm run db:seed; rodar a mao, nunca no entrypoint) ---
# Sem senha: o seed imprime os links de primeiro acesso.
SEED_SUPER_ADMIN_EMAIL=voce@exemplo.com
SEED_DONO_EMAIL=dono@exemplo.com
SEED_DONO_NOME=Nome do Dono
